# Normaliza finales de línea a LF en el repositorio; el checkout queda en LF.
* text=auto eol=lf

# Scripts de Windows deben quedarse en CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Wrapper de Gradle: el shell script en LF, el .bat en CRLF.
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binarios (sin normalizar).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.jar binary
*.keystore binary
*.jks binary
