# Copia este fichero a `android/keystore.properties` para firmar el release.
# El fichero real está en .gitignore y nunca debe subirse al repositorio.
#
# Generar un keystore nuevo:
#   keytool -genkeypair -v -keystore keystore/cuentas-claras.jks \
#     -alias cuentas-claras -keyalg RSA -keysize 2048 -validity 10000
storeFile=../keystore/cuentas-claras.jks
storePassword=changeme
keyAlias=cuentas-claras
keyPassword=changeme
